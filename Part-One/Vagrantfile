#vagrant up: starts the VMs
#vagrant global-status: see the active/inactive VMs

Vagrant.configure("2") do |config|

	# S
	config.vm.define "mougnouS" do |machine1|
		machine1.vm.box = "ubuntu/bionic64"
		machine1.vm.hostname = "mougnouS"
	  
		machine1.vm.provider "virtualbox" do |vb|
			vb.memory = 1024
			vb.cpus = 1
		end
		config.vm.network "public_network", ip: "192.168.56.110"
		config.vm.provision "shell", inline: <<-SHELL
			sudo apt-get update
			curl -sfL https://get.k3s.io | sh -
			sudo apt-get install -y openssh-server
	  
			ssh-keygen -t rsa -N ""	  
			sshpass -p 'vagrant' ssh-copy-id -o StrictHostKeyChecking=no vagrant@192.168.56.111
		SHELL
	end
	#End S
	
	#SW
	config.vm.define "mougnouSW" do |machine2|
		machine2.vm.box = "ubuntu/bionic64"
		machine2.vm.hostname = "mougnouSW"
		
		machine2.vm.provider "virtualbox" do |vb|
		vb.memory = 1024  
		vb.cpus = 1
		end
		config.vm.network "public_network", ip: "192.168.56.111"
		config.vm.provision "shell", inline: <<-SHELL
			sudo apt-get update
			curl -sfL https://get.k3s.io | sh -
			sudo apt-get install -y openssh-server
	  
			ssh-keygen -t rsa -N ""	  
			sshpass -p 'vagrant' ssh-copy-id -o StrictHostKeyChecking=no vagrant@192.168.56.111
		SHELL
	end
	#End SW
end
  
	