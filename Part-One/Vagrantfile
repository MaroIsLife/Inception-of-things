
Vagrant.configure("2") do |config|

	config.vm.synced_folder "host_folder", "/vagrant/tokens"
	# S
	config.vm.define "mougnouS" do |machine1|
		machine1.vm.box = "ubuntu/bionic64"
		machine1.vm.hostname = "mougnouS"
	  
		machine1.vm.provider "virtualbox" do |vb|
			vb.memory = 1024
			vb.cpus = 1
		end
		machine1.vm.network "private_network", ip: "192.168.56.110"
		machine1.vm.provision "shell", inline: <<-SHELL
			sudo apt-get update
			curl -sfL https://get.k3s.io | sh -
			sudo cat /var/lib/rancher/k3s/server/node-token > /vagrant/tokens/token_file
		SHELL
	end
	#End S
	
	#SW
	config.vm.define "mougnouSW" do |machine2|
		machine2.vm.box = "ubuntu/bionic64"
		machine2.vm.hostname = "mougnouSW"

		
		machine2.vm.provider "virtualbox" do |vb|
			vb.memory = 1024  
			vb.cpus = 1
		end
		machine2.vm.network "private_network", ip: "192.168.56.111"
		machine2.vm.provision "shell", inline: <<-SHELL
			sudo apt-get update
			URL="https://192.168.56.110:6443"
			sudo cat /home/tokens/token_file
			TOKEN=$(sudo cat /vagrant/tokens/token_file)
			echo $URL
			echo $TOKEN 
			curl -sfL https://get.k3s.io | K3S_URL=$URL K3S_TOKEN=$TOKEN sh -
		SHELL
	end
	#End SW
end
  

#vagrant up: starts the VMs
#vagrant global-status: see the active/inactive VMs   sleep 10 rovision: run vagrant scripts
#Ping [IP] to ping other private network machines
