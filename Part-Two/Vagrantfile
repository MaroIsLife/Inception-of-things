#vagrant up: starts the VMs
#vagrant global-status: see the active/inactive VMs

Vagrant.configure("2") do |config|

	config.vm.synced_folder "./yamls", "/home/vagrant/yamls"
	config.vm.provision "shell", path: "script.sh"
	config.vm.define "mougnouS" do |machine2|
		machine2.vm.box = "ubuntu/bionic64"
		machine2.vm.hostname = "mougnouS"

		machine2.vm.provider "virtualbox" do |vb|
		vb.memory = 1024  
		vb.cpus = 1
		end
		machine2.vm.network "private_network", ip: "192.168.56.110"
	end
end